# Comma-separated LLM API keys (at least 2). Key IDs are key_1, key_2, ...
LLM_API_KEYS=your_key_1,your_key_2

# SQLite database URL
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Failure simulation toggle (true enables X-Simulate-Failure header processing)
ENABLE_FAILURE_SIMULATION=false

# Model identifier for LiteLLM
LLM_MODEL=gemini/gemini-2.0-flash

# Default system prompt for sessions without an explicit override
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Disk cache storage directory
CACHE_DIR=/data/cache

# Mock LLM provider for tests and local verification without real keys
MOCK_LLM=false

# Frontend API base URL (baked into frontend at build time)
VITE_API_URL=http://localhost:8000
